# Скопировать в .env (файл в .gitignore, не коммитить) и заполнить реальными
# значениями конкретного Supabase-проекта. Без этих переменных приложение
# работает на mock-данных (см. src/services/supabaseClient.js) — это
# осознанный dev-fallback, а не ошибка конфигурации.

# Только anon/publishable ключ. НИКОГДА не помещать сюда service_role key —
# он даёт полный доступ в обход RLS и не должен попадать в frontend-бандл.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Клуб, к которому привязан этот экземпляр портала (не секрет). CLUB_ID
# должен точно совпадать с clubs.club_short_name в базе. Без этих переменных
# в dev используется demo-заглушка, в production — ошибка конфигурации
# (см. src/config/portalClub.js).
VITE_PORTAL_CLUB_ID=
VITE_PORTAL_CLUB_NAME=
