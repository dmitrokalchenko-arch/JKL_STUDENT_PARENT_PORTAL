# STAGE 1 — worker пока запускается только локально (node --env-file или
# dotenv), НЕ задеплоен. Скопировать в .env и заполнить реальными
# значениями ЭТОГО Supabase-проекта (те же, что уже в src/services/*
# frontend-клиента) — .env НЕ коммитить (см. .gitignore).
#
# ВАЖНО: здесь НЕТ и не должно быть SUPABASE_SERVICE_ROLE_KEY — эта
# архитектура (задание, раздел 4) намеренно работает только через JWT
# тренера, пересылаемый в Authorization header КАЖДОГО запроса, без
# service_role вообще.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Опционально — порт локального HTTP-сервера (по умолчанию 8787).
PORT=8787
